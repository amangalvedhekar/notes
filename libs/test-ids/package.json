{
  "name": "@amangalvedhekar/test-ids",
  "version": "0.0.1",
  "description": "Shared test identifiers for the notes component library and end-to-end tests.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "vite build && tsc --build tsconfig.lib.json --force"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amangalvedhekar/notes.git",
    "directory": "libs/test-ids"
  }
}

{
  "name": "@amangalvedhekar/components",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "libs/components",
        "commands": [
          "vite build",
          "tsc --build tsconfig.lib.json --force"
        ],
        "parallel": false
      }
    }
  }
}

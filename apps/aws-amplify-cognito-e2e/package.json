{
  "name": "@notes/aws-amplify-cognito-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:noop"
      },
      "build-ios": {
        "dependsOn": [
          {
            "projects": [
              "@amangalvedhekar/components"
            ],
            "target": "build"
          }
        ],
        "options": {
          "args": [
            "--args=\"-c ios.sim.debug\""
          ]
        },
        "configurations": {
          "production": {
            "args": [
              "--args=\"-c ios.sim.release\""
            ]
          }
        },
        "command": "nx run @notes/aws-amplify-cognito-e2e:detox-build"
      },
      "test-ios": {
        "dependsOn": [
          {
            "projects": [
              "@amangalvedhekar/components"
            ],
            "target": "build"
          },
          "@notes/aws-amplify-cognito-e2e:build-ios"
        ],
        "options": {
          "args": [
            "--args=\"-c ios.sim.debug\""
          ]
        },
        "configurations": {
          "production": {
            "args": [
              "--args=\"-c ios.sim.release\""
            ]
          }
        },
        "command": "nx run @notes/aws-amplify-cognito-e2e:detox-test"
      },
      "build-android": {
        "dependsOn": [
          {
            "projects": [
              "@amangalvedhekar/components"
            ],
            "target": "build"
          }
        ],
        "options": {
          "args": [
            "--args=\"-c android.emu.debug\""
          ]
        },
        "configurations": {
          "production": {
            "args": [
              "--args=\"-c android.emu.release\""
            ]
          }
        },
        "command": "nx run @notes/aws-amplify-cognito-e2e:detox-build"
      },
      "test-android": {
        "dependsOn": [
          {
            "projects": [
              "@amangalvedhekar/components"
            ],
            "target": "build"
          },
          "@notes/aws-amplify-cognito-e2e:build-android"
        ],
        "options": {
          "args": [
            "--args=\"-c android.emu.debug\""
          ]
        },
        "configurations": {
          "production": {
            "args": [
              "--args=\"-c android.emu.release\""
            ]
          }
        },
        "command": "nx run @notes/aws-amplify-cognito-e2e:detox-test"
      }
    },
    "implicitDependencies": [
      "@notes/aws-amplify-cognito"
    ],
    "// targets": "to see all targets run: nx show project @notes/aws-amplify-cognito-e2e --web"
  },
  "dependencies": {
    "@amangalvedhekar/test-ids": "0.0.1"
  }
}
